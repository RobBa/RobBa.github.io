      "updated": 1774527575175,
      "link": null,
      "locked": false,
      "text": "Py_List -> std::vector,\nstore inputs\n\nWhile(!converged)\n{\n Generate input std::vector\n std::vector<int> -> Py_List\n Call Python with Py_List\n\n Py_List -> std::vector\n Process network output\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Py_List -> std::vector,\nstore inputs\n\nWhile(!converged)\n{\n Generate input std::vector\n std::vector<int> -> Py_List\n Call Python with Py_List\n\n Py_List -> std::vector\n Process network output\n}",
      "autoResize": true,
      "lineHeight": 1.25
